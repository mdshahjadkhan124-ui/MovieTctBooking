# Render sets this automatically in production — leave blank locally to
# default to 5000, or set it to match your local setup.
PORT=

# MongoDB Atlas (or any reachable Mongo) connection string.
MONGO_URI=

# Redis connection string. Use rediss:// (not redis://) for a TLS-only
# provider like Upstash — the redis client auto-enables TLS from the scheme.
REDIS_URL=

# Redis used by the test suite ONLY (npm run test:integration). Must be a
# DIFFERENT instance from REDIS_URL — vitest.global-setup.js refuses to run
# if the two resolve to the same host/port/database. Note that Upstash
# supports only database 0, so a different db number on the same host is not
# a valid way to separate them. Leave blank to fall back to a local Redis on
# redis://127.0.0.1:6379 (e.g. docker run -d -p 6379:6379 redis:7-alpine).
TEST_REDIS_URL=

# "development" locally; set to "production" on Render. Controls cookie
# sameSite/secure flags and whether CORS requires CLIENT_URL to be set.
NODE_ENV=

# The deployed frontend's exact origin (e.g. https://your-app.vercel.app).
# Required in production — CORS will refuse to start without it.
CLIENT_URL=

JWT_SECRET=
JWT_EXPIRES_IN=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Stripe test-mode (or live) secret key.
STRIPE_SECRET_KEY=

# From the Stripe CLI (`stripe listen`) locally, or the dashboard's webhook
# endpoint secret in production.
STRIPE_WEBHOOK_SECRET=

# TMDB v4 read access token (a long JWT, not the shorter v3 api_key) — used
# only by the seed script to fetch real movie data; never called at runtime.
TMDB_API_KEY=

# How often the background waitlist sweeper runs (ms, default 60000). It
# catches seat holds that expired in Redis, which emits no event of its own —
# see services/waitlistSweeper.js. Optional.
WAITLIST_SWEEP_INTERVAL_MS=

# Rate limiting (Redis-backed — see middleware/rateLimiters.js). All
# optional; sensible defaults apply if unset. RATE_LIMIT_* governs the
# general API; AUTH_RATE_LIMIT_* is the much stricter limit on
# /api/auth/login and /api/auth/signup specifically.
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_WINDOW_MS=
AUTH_RATE_LIMIT_MAX=
